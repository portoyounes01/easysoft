# Supabase Configuration
VITE_SUPABASE_URL=https://<my-project-ref>.supabase.co
VITE_SUPABASE_ANON=<my-anon-public-key>
HARDWARE_TRACE_CUPS=0
# Example:
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Development Environment
NODE_ENV=development

# Application Configuration
VITE_APP_NAME=POS System
VITE_APP_VERSION=1.0.0

# Fiscal AT — configure at deploy time (not in Settings UI). Vite inlines VITE_* into the client bundle.
# VITE_FISCAL_CERTIFICATION_NUMBER=196/AT
# VITE_FISCAL_SOFTWARE_CERT_NUMBER=PTR-A-001
# VITE_FISCAL_HASH_CONTROL_VERSION=1
# Generate PKCS#8: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -outform PEM
# Put the full PEM on one line with \n escapes, or use JSON-style quotes via: node -e "const c=require('child_process');const p=c.execSync('openssl genrsa 2048 2>/dev/null | openssl pkcs8 -topk8 -nocrypt -outform PEM',{encoding:'utf8'}).trim();console.log('VITE_FISCAL_RSA_PRIVATE_KEY_PEM='+JSON.stringify(p))"
# VITE_FISCAL_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloud fiscal issuer credentials (Supabase Edge Function secrets, NOT client env) ──
# These never reach the browser. Set them on the deployed functions, e.g.:
#   supabase secrets set VENDUS_API_KEY=... INVOICEXPRESS_API_KEY=... FISKALY_API_KEY=... FISKALY_API_SECRET=...
# Vendus (function: vendus-fiscal)
#   VENDUS_API_KEY=...
#   VENDUS_BASE_URL=https://www.vendus.pt/ws/v1.1   # optional override
# InvoiceXpress (function: invoicexpress-fiscal) — account subdomain set in Settings; key here:
#   INVOICEXPRESS_API_KEY=...
# Fiskaly SIGN PT (function: fiskaly-fiscal) — environment/ids set in Settings; key/secret here:
#   FISKALY_API_KEY=...
#   FISKALY_API_SECRET=...
# Azure Document Intelligence (function: extract-purchase-document)
# Create a Document Intelligence resource, then set its Keys and Endpoint values:
#   AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
#   AZURE_DOCUMENT_INTELLIGENCE_KEY=...
# Deploy:
#   supabase functions deploy extract-purchase-document
#
# AI assistant (function: assistant) — Claude API key. GDPR: use an Anthropic
# org with a signed DPA and zero data retention. Never prefix with VITE_.
#   ANTHROPIC_API_KEY=sk-ant-...
# Deploy:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy assistant
# Then populate the how-to knowledge base once: npm run build:kb
#
# WhatsApp channel (Phase 2 — functions: whatsapp-webhook, whatsapp-pair-code)
# From Meta: developer.facebook.com -> your WhatsApp app.
#   WHATSAPP_TOKEN=EAAG...            # access token for the WhatsApp Business number
#   WHATSAPP_PHONE_NUMBER_ID=1234...  # the number's ID (Meta -> WhatsApp -> API setup)
#   WHATSAPP_APP_SECRET=...           # App Settings -> Basic -> App Secret (verifies webhook HMAC)
#   WHATSAPP_VERIFY_TOKEN=<make-up-any-string>  # you invent this; enter the same value in Meta's webhook config
#   WHATSAPP_BUSINESS_NUMBER=+3519... # optional, shown to the owner in the Link-WhatsApp UI
# Deploy:
#   supabase secrets set WHATSAPP_TOKEN=... WHATSAPP_PHONE_NUMBER_ID=... WHATSAPP_APP_SECRET=... WHATSAPP_VERIFY_TOKEN=... WHATSAPP_BUSINESS_NUMBER=+3519...
#   supabase functions deploy whatsapp-webhook whatsapp-pair-code
# Webhook URL to paste into Meta: https://<project-ref>.supabase.co/functions/v1/whatsapp-webhook
#
# Voice notes (WhatsApp audio -> text) via Soniox async STT, hinted to Portuguese/Spanish.
# The webhook downloads the voice note, transcribes it, then feeds the text to the assistant.
# GDPR: the audio + transcription are deleted from Soniox right after the text is read.
#   SONIOX_API_KEY=...   # from console.soniox.com
# Deploy:
#   supabase secrets set SONIOX_API_KEY=...
#   supabase functions deploy whatsapp-webhook
