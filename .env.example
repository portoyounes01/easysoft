# Supabase Configuration
VITE_SUPABASE_URL=https://<my-project-ref>.supabase.co
VITE_SUPABASE_ANON=<my-anon-public-key>
HARDWARE_TRACE_CUPS=0
# Example:
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Development Environment
NODE_ENV=development

# Application Configuration
VITE_APP_NAME=POS System
VITE_APP_VERSION=1.0.0

# Fiscal AT — configure at deploy time (not in Settings UI). Vite inlines VITE_* into the client bundle.
# VITE_FISCAL_CERTIFICATION_NUMBER=196/AT
# VITE_FISCAL_SOFTWARE_CERT_NUMBER=PTR-A-001
# VITE_FISCAL_HASH_CONTROL_VERSION=1
# Generate PKCS#8: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -outform PEM
# Put the full PEM on one line with \n escapes, or use JSON-style quotes via: node -e "const c=require('child_process');const p=c.execSync('openssl genrsa 2048 2>/dev/null | openssl pkcs8 -topk8 -nocrypt -outform PEM',{encoding:'utf8'}).trim();console.log('VITE_FISCAL_RSA_PRIVATE_KEY_PEM='+JSON.stringify(p))"
# VITE_FISCAL_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
